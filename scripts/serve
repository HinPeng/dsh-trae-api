#!/bin/sh
# Trae Local API - start / stop / restart / status
# Usage:
#   scripts/serve start    - start in background, log to server.log
#   scripts/serve stop     - stop the background server
#   scripts/serve restart  - stop then start
#   scripts/serve status   - show whether the server is running

set -eu

DIR="$(cd "$(dirname "$0")/.." && pwd)"
PID_FILE="$DIR/.serve.pid"
LOG_FILE="$DIR/server.log"

port() {
  # Read PORT from .env (fallback 9220)
  if [ -f "$DIR/.env" ]; then
    sed -n 's/^PORT=//p' "$DIR/.env" | head -1
  else
    echo 9220
  fi
}

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

do_start() {
  if is_running; then
    echo "[serve] Already running (PID $(cat "$PID_FILE"))"
    return 0
  fi
  # Clean up stale process on port
  P="$(port)"
  OLD_PIDS="$(lsof -ti :"$P" 2>/dev/null || true)"
  if [ -n "$OLD_PIDS" ]; then
    echo "[serve] Killing stale process(es) on port $P: $OLD_PIDS"
    echo "$OLD_PIDS" | xargs kill 2>/dev/null || true
    sleep 1
  fi
  echo "[serve] Starting on port $P (log: $LOG_FILE)"
  cd "$DIR"
  nohup node src/server.js >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  # Wait briefly and confirm it is listening
  for i in 1 2 3 4 5; do
    if lsof -ti :"$P" >/dev/null 2>&1; then
      echo "[serve] Started (PID $(cat "$PID_FILE"))"
      return 0
    fi
    sleep 1
  done
  echo "[serve] Warning: process started but port $P not yet listening; check $LOG_FILE"
}

do_stop() {
  if ! is_running; then
    rm -f "$PID_FILE"
    echo "[serve] Not running (no valid PID file)"
    return 0
  fi
  PID="$(cat "$PID_FILE")"
  echo "[serve] Stopping PID $PID"
  kill "$PID" 2>/dev/null || true
  sleep 1
  if kill -0 "$PID" 2>/dev/null; then
    echo "[serve] Force killing PID $PID"
    kill -9 "$PID" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo "[serve] Stopped"
}

do_status() {
  if is_running; then
    echo "[serve] Running (PID $(cat "$PID_FILE"))"
  else
    rm -f "$PID_FILE"
    echo "[serve] Not running"
  fi
}

case "${1:-}" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; do_start ;;
  status)  do_status ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
