#!/bin/sh
# Trae Local API - start / stop / restart / status
# Usage:
#   scripts/serve start    - start in background, log to server.log
#   scripts/serve stop     - stop the background server
#   scripts/serve restart  - stop then start
#   scripts/serve status   - show whether the server is running

set -eu

DIR="$(cd "$(dirname "$0")/.." && pwd)"
PID_FILE="$DIR/.serve.pid"
LOG_FILE="$DIR/server.log"

port() {
  # Read PORT from .env (fallback 9220)
  if [ -f "$DIR/.env" ]; then
    sed -n 's/^PORT=//p' "$DIR/.env" | head -1
  else
    echo 9220
  fi
}

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

do_start() {
  if is_running; then
    echo "[serve] Already running (PID $(cat "$PID_FILE"))"
    return 0
  fi
  # Clean up stale process on port
  P="$(port)"
  OLD_PIDS="$(lsof -ti :"$P" 2>/dev/null || true)"
  if [ -n "$OLD_PIDS" ]; then
    echo "[serve] Killing stale process(es) on port $P: $OLD_PIDS"
    echo "$OLD_PIDS" | xargs kill 2>/dev/null || true
    sleep 1
  fi
  echo "[serve] Starting on port $P (log: $LOG_FILE)"
  cd "$DIR"
  nohup node src/server.js >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  # Wait briefly and confirm it is listening
  for i in 1 2 3 4 5; do
    if lsof -ti :"$P" >/dev/null 2>&1; then
      echo "[serve] Started (PID $(cat "$PID_FILE"))"
      return 0
    fi
    sleep 1
  done
  echo "[serve] Warning: process started but port $P not yet listening; check $LOG_FILE"
}

do_stop() {
  # Collect PIDs from the pid file and from the port (covers processes
  # started outside this script, e.g. via npm start)
  PIDS=""
  if is_running; then
    PIDS="$(cat "$PID_FILE")"
  else
    rm -f "$PID_FILE"
  fi
  P="$(port)"
  PORT_PIDS="$(lsof -ti :"$P" 2>/dev/null || true)"
  if [ -n "$PORT_PIDS" ]; then
    if [ -n "$PIDS" ]; then
      PIDS="$(printf '%s\n%s\n' "$PIDS" "$PORT_PIDS" | sort -u)"
    else
      PIDS="$PORT_PIDS"
    fi
  fi
  if [ -z "$PIDS" ]; then
    echo "[serve] Not running"
    return 0
  fi
  echo "[serve] Stopping PID $PIDS"
  printf '%s\n' $PIDS | xargs kill 2>/dev/null || true
  sleep 1
  REMAINING=""
  for pid in $PIDS; do
    if kill -0 "$pid" 2>/dev/null; then
      REMAINING="$REMAINING $pid"
    fi
  done
  if [ -n "$REMAINING" ]; then
    echo "[serve] Force killing PID:$REMAINING"
    printf '%s\n' $REMAINING | xargs kill -9 2>/dev/null || true
  fi
  echo "[serve] Stopped"
}

do_status() {
  P="$(port)"
  if is_running; then
    echo "[serve] Running (PID $(cat "$PID_FILE"))"
  elif [ -n "$(lsof -ti :"$P" 2>/dev/null || true)" ]; then
    echo "[serve] Running on port $P (not started by this script)"
  else
    rm -f "$PID_FILE"
    echo "[serve] Not running"
  fi
}

case "${1:-}" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; do_start ;;
  status)  do_status ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
